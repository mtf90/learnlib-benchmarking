<?xml version="1.0" encoding="UTF-8" ?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="pu" transaction-type="RESOURCE_LOCAL">

        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <class>de.learnlib.benchmarking.entity.DBIdentified</class>
        <class>de.learnlib.benchmarking.entity.DBExperiment</class>
        <class>de.learnlib.benchmarking.entity.DBStatistics</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.hsqldb.jdbc.JDBCDriver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:hsqldb:file:./data/db/benchmarking;shutdown=true"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Schema-Generierung -->
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>

            <!-- EclipseLink Logging (hilft bei der Fehlersuche) -->
            <!--<property name="eclipselink.logging.level" value="FINEST"/>-->
            <property name="eclipselink.logging.level" value="WARNING"/>
        </properties>
    </persistence-unit>
</persistence>
